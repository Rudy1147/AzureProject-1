{
    "location": "canadaeast",
    "properties": {

        "dataSources": {
            "logFiles": [
                {
                    "name": "ContainerLogs",
                    "streams": [
                        "Custom-ContainerLogs"
                    ],
                    "filePatterns": [
                        "/var/log/AzureProject-1/*.log"
                    ],
                    "format": "text"
                }
            ]
        },

        "destinations": {
            "logAnalytics": [
                {
                    "workspaceResourceId": "/subscriptions/c16c7388-db07-461e-b012-b977c33ffebb/resourceGroups/eggRG/providers/Microsoft.OperationalInsights/workspaces/eggVM-logs",
                    "name": "logDestination"
                }
            ]
        },
        
        "dataFlows": [
            {
                "streams": [
                    "Custom-ContainerLogs"
                ],
                "destinations": [
                    "logDestination"
                ]
            }
        ]
    }
}